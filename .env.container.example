# =============================================================================
# OpenCode Docker Container Environment (.env.container)
# Copy this file to .env.container and populate your credentials:
#   cp .env.container.example .env.container
#
# SECURITY NOTICE:
# Variables in this file are passed directly into the Docker container
# via 'docker run --env-file .env.container'.
# 
# Host credentials (such as GH_APP_ID and app.pem) belong exclusively in .env
# and should NEVER be added to this file.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Set the keys your OpenCode agent uses)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIzaSy..."
# OPENROUTER_API_KEY="sk-or-..."
# DEEPSEEK_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# MISTRAL_API_KEY="..."

# Local or custom LLM endpoints (e.g. Ollama running on host machine)
# OLLAMA_API_BASE="http://host.docker.internal:11434"
# OPENAI_API_BASE=""

# -----------------------------------------------------------------------------
# Model Context Protocol (MCP) & Tool Credentials
# Add any arbitrary environment variables required by your MCP servers or tools.
# -----------------------------------------------------------------------------
# BRAVE_API_KEY="BSA..."
# TAVILY_API_KEY="tvly-..."
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
# POSTGRES_URL="postgresql://user:password@localhost:5432/mydb"
