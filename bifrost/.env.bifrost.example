# =============================================================================
# Bifrost Master Credentials (.env.bifrost)
#
# SECURITY NOTICE:
# Used exclusively by the Bifrost Gateway daemon.
# NEVER MOUNTED OR EXPOSED TO THE OPENCODE AGENT CONTAINER.
#
# Copy this file to .env.bifrost or use bifrost UI to setup things:
#   cp bifrost/.env.bifrost.example bifrost/.env.bifrost
# =============================================================================

# -----------------------------------------------------------------------------
# Gateway Port Configuration (Optional - Defaults to 8321)
# -----------------------------------------------------------------------------
# BIFROST_PORT="8321"

# -----------------------------------------------------------------------------
# LLM Provider Master API Keys
# (Set the upstream keys you want Bifrost to proxy requests to)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIzaSy..."
# OPENROUTER_API_KEY="sk-or-..."
# DEEPSEEK_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."

# -----------------------------------------------------------------------------
# Model Context Protocol (MCP) Tool Credentials
# -----------------------------------------------------------------------------
# BRAVE_API_KEY="BSA..."
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
