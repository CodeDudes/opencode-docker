# =============================================================================
# Bifrost Master Credentials (.env.bifrost)
#
# SECURITY NOTICE:
# Variables in this file are used exclusively by the Bifrost Gateway daemon.
# THEY ARE NEVER MOUNTED OR EXPOSED TO THE AGENT DOCKER CONTAINER.
#
# Copy this file to .env.bifrost to configure your master provider credentials:
#   cp bifrost/.env.bifrost.example bifrost/.env.bifrost
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Master API Keys
# (Set the upstream keys you want Bifrost to proxy requests to)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIzaSy..."
# OPENROUTER_API_KEY="sk-or-..."
# DEEPSEEK_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."

# -----------------------------------------------------------------------------
# Model Context Protocol (MCP) Tool Credentials
# -----------------------------------------------------------------------------
# BRAVE_API_KEY="BSA..."
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
