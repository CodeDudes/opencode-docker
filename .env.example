# =============================================================================
# OpenCode Docker Configuration (.env)
# Copy this file to .env and populate your credentials:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub App Configuration (Required for GitHub authentication & Git commits)
# -----------------------------------------------------------------------------
GH_APP_ID="YOUR_APP_ID"
GH_INSTALLATION_ID="YOUR_INSTALLATION_ID"
GH_APP_SLUG="your-org-opencode-bot"

# Optional path to private key (defaults to ./app.pem inside this repository)
# GH_APP_KEY_PATH="./app.pem"

# -----------------------------------------------------------------------------
# LLM Provider API Keys (Uncomment and set what your OpenCode agent uses)
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIzaSy..."
# OPENROUTER_API_KEY="sk-or-..."
# DEEPSEEK_API_KEY="sk-..."
# GROQ_API_KEY="gsk_..."
# MISTRAL_API_KEY="..."

# -----------------------------------------------------------------------------
# Optional Runtime Overrides
# -----------------------------------------------------------------------------
# OPENCODE_IMAGE="opencode-dev:latest"

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) & Tool API Keys (Optional)
# Any variable starting with MCP_* is automatically forwarded into the container.
# -----------------------------------------------------------------------------
# BRAVE_API_KEY="BSA..."
# TAVILY_API_KEY="tvly-..."
# DATABASE_URL="postgresql://user:pass@host:5432/mydb"
# MCP_CUSTOM_TOKEN="secret-token"
