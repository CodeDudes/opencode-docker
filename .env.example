# =============================================================================
# OpenCode Docker Host Configuration (.env)
# Required strictly for the host runner script (ocd) to mint ephemeral tokens.
# 
# SECURITY NOTICE:
# Variables in this file are used exclusively by the host runner script.
# THEY ARE NEVER MOUNTED OR FORWARDED INTO THE DOCKER CONTAINER.
# 
# To configure LLM API keys and MCP tool credentials for the agent inside
# the container, use .env.container (see .env.container.example).
# =============================================================================

# -----------------------------------------------------------------------------
# GitHub App Configuration (Host Only - Required for token minting)
# -----------------------------------------------------------------------------
GH_APP_ID="YOUR_APP_ID"
GH_INSTALLATION_ID="YOUR_INSTALLATION_ID"
GH_APP_SLUG="your-org-opencode-bot"

# Optional path to host private key (defaults to ./app.pem inside this repository)
# GH_APP_KEY_PATH="./app.pem"

# -----------------------------------------------------------------------------
# Host Runtime Overrides
# -----------------------------------------------------------------------------
# OPENCODE_IMAGE="opencode-dev:latest"
